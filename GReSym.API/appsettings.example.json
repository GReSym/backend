{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=###;Port=###;Database=###;User=###;Password=###;"
  },
  "AllowedHosts": "*",
  "Ml": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 10
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "User": "###",
    "Password": "###",
    "Exchange": "gresym.tasks",
    "DeadLetterExchange": "gresym.dlx",
    "VectorizeQueue": "ml.vectorize-game",
    "VectorizeDeadLetterQueue": "ml.vectorize-game.dlq",
    "VectorizeRoutingKey": "game.vectorize",
    "DeliveryLimit": 5
  },
  "Jwt": {
    "Key": "###",
    "Issuer": "GReSym",
    "Audience": "GReSymUsers",
    "ExpireMinutes": 60
  }
}
