{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=###;Port=###;Database=###;User=###;Password=###;"
  },
  "AllowedHosts": "*",
  "Ml": {
    "BaseUrl": "http://localhost:8000",
    "ScanTimeoutSeconds": 120,
    "SearchTimeoutSeconds": 60
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "User": "###",
    "Password": "###",
    "Exchange": "gresym.tasks",
    "DeadLetterExchange": "gresym.dlx",
    "VectorizeQueue": "ml.vectorize-game",
    "VectorizeDeadLetterQueue": "ml.vectorize-game.dlq",
    "VectorizeRoutingKey": "game.vectorize",
    "DeliveryLimit": 5,
    "EvaluationQueue": "ml.evaluate",
    "EvaluationDeadLetterQueue": "ml.evaluate.dlq",
    "EvaluationRoutingKey": "evaluation.run",
    "EvaluationDeliveryLimit": 2,
    "EvaluationResultsQueue": "api.evaluation-results",
    "EvaluationResultsDeadLetterQueue": "api.evaluation-results.dlq",
    "EvaluationResultsRoutingKey": "evaluation.result",
    "RecommendationQueue": "ml.recommend",
    "RecommendationDeadLetterQueue": "ml.recommend.dlq",
    "RecommendationRoutingKey": "recommendation.run",
    "RecommendationDeliveryLimit": 3,
    "RecommendationResultsQueue": "api.recommendation-results",
    "RecommendationResultsDeadLetterQueue": "api.recommendation-results.dlq",
    "RecommendationResultsRoutingKey": "recommendation.result"
  },
  "Recommendations": {
    "HistoryGamesLimit": 5
  },
  "Jwt": {
    "Key": "###",
    "Issuer": "GReSym",
    "Audience": "GReSymUsers",
    "ExpireMinutes": 60
  }
}
